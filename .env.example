# Copy this file to .env and fill in your real PPI credentials.
# Get them from your PPI account -> "Gestiones" -> activate the API service:
# https://itatppi.github.io/ppi-official-api-docs/primerosPasos/credenciales/
#
# .env is gitignored — never commit real keys.

PPI_PUBLIC_KEY=
PPI_PRIVATE_KEY=

# false = production, true = sandbox (if PPI provides one for your account)
PPI_SANDBOX=false
